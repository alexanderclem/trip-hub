// Cloudflare Workers static-assets config (used if the project was created as a Worker;
// Cloudflare Pages ignores this file). Serves the built PWA from dist/ with SPA routing.
{
  "name": "trip-hub",
  "main": "worker/index.ts",
  // Always produce the app assets when deploying from a clean Git checkout.
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    // Agent and crawler files go to the Worker too, so a missing one is a real 404, not the app's page.
    "run_worker_first": ["/api/*", "/mcp", "/.well-known/*", "/llms.txt", "/llms-full.txt", "/robots.txt", "/sitemap.xml"],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "MCP_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "MCP_RESOURCE_URL": "https://trip-hub.alexanderclem12.workers.dev/mcp",
    "IDEAS_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "SUPABASE_URL": "https://croqjdvzbpcscdcshnet.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_FpJvcMvfUFtCO49tcx0tGA_fZUqNroP"
  }
}
