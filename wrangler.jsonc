// Cloudflare Workers static-assets config (used if the project was created as a Worker;
// Cloudflare Pages ignores this file). Serves the built PWA from dist/ with SPA routing.
{
  "name": "trip-hub",
  "main": "worker/index.ts",
  // Always produce the app assets when deploying from a clean Git checkout.
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    // Every page goes to the Worker first (worker/index.ts servePage): app routes get noindex, unknown
    // paths a real 404, plain http a redirect. Static files skip it, so public/_headers still applies
    // to them (the service worker's no-cache, font caching) and they cost no Worker requests.
    "run_worker_first": [
      "/*",
      "!/assets/*", "!/fonts/*", "!/map-assets/*", "!/packs/*", "!/brand/*", "!/images/*",
      "!/sw.js", "!/registerSW.js", "!/push-sw.js", "!/workbox-*", "!/manifest.webmanifest",
      "!/appearance.js", "!/icon.svg", "!/icon-192.png", "!/icon-512.png", "!/apple-touch-icon.png"
    ],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "TRAVEL_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "MCP_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // The booking agent spends paid DeepSeek, LiteAPI and Google Routes calls.
    { "name": "AGENT_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 2, "period": 60 } }
  ],
  // Branch Previews have their own bindings and use the isolated staging database.
  "previews": {
    "ai": { "binding": "AI" },
    "ratelimits": [
      { "name": "TRAVEL_RATE_LIMITER", "namespace_id": "2003", "simple": { "limit": 30, "period": 60 } },
      { "name": "AI_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 6, "period": 60 } },
      { "name": "MCP_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
      { "name": "AGENT_RATE_LIMITER", "namespace_id": "2004", "simple": { "limit": 2, "period": 60 } }
    ],
    // Use a LiteAPI sandbox key (sand_...) for Previews; production access is separate.
    "vars": {
      "DEEPSEEK_MODEL": "deepseek-flash",
      "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
      "SUPABASE_URL": "https://knufofvmqopuvijvtzow.supabase.co",
      "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_RMYHjsWiavcHOLDMGKdJDA_R-NBD4Ge"
    }
  },
  "vars": {
    "MCP_RESOURCE_URL": "https://trip-hub.alexanderclem12.workers.dev/mcp",
    // Official API alias for DeepSeek-V4.1-Flash-1017; confirm account access with GET /models.
    // Used by the trip agent and by every Stowie turn (worker/deepseek.ts).
    "DEEPSEEK_MODEL": "deepseek-flash",
    // Workers AI is used only for receipt and ticket scans (worker/scan.ts).
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "SUPABASE_URL": "https://croqjdvzbpcscdcshnet.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_FpJvcMvfUFtCO49tcx0tGA_fZUqNroP"
  }
}
